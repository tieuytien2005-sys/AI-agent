# ==============================================================================
# AI Procurement Agent - Local Environment Configuration (.env.example)
# Copy this file to .env and replace placeholder values with your secure secrets.
# ==============================================================================

# Database Name and Superuser / App User
POSTGRES_DB=procurement
POSTGRES_USER=app

# Required: Database user password (DO NOT leave as default, replace with a strong password)
DB_PASSWORD=change_me_db_password

# Host exposed port for PostgreSQL (change if port 5432 is already occupied on your host)
DB_PORT=5432

# Password for the AI Agent service role (agent_svc) used in db/permissions.sql
AGENT_DB_PASSWORD=change_me_agent_password
